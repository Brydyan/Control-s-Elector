# =============================================================================
# .env.example — plantilla de variables para compose.yaml
# =============================================================================
# Dev: valores por defecto embebidos en compose.yaml ya alcanzan
#      (docker compose --profile dev up -d, sin --env-file).
# Prod: copiar a .env.prod, completar con valores reales y correr:
#      docker compose --profile prod --env-file .env.prod up -d
# =============================================================================

# --- Entorno ---
APP_ENV=prod
RESTART_POLICY=unless-stopped

# --- Base de datos ---
DB_NAME=electoral_db
DB_USER=electoral_user
DB_PASSWORD=CAMBIAR_por_password_real
DB_PORT=5432
POSTGRES_MEM_LIMIT=1G

# --- Storage S3 (Supabase en producción) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=electoral-evidences
