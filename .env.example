# =============================================================================
# .env.example — Plantilla canónica de variables de entorno
# =============================================================================
#
# Este archivo ES el template versionado. Está OK que se commitee.
#
# Para generar tu .env local:
#   cp .env.example .env
#   # editar valores (mínimamente: cambiar APP_JWT_SECRET y
#   # APP_JWT_REFRESH_PEPPER por secretos generados con
#   # `openssl rand -base64 48`)
#
# ─── Cómo se usan estas variables ──────────────────────────────────────────
# Variables marcadas con [compose] las consume docker-compose.
# Variables marcadas con [quarkus] las consume Quarkus via MicroProfile Config:
#   ${VAR} en src/main/resources/application.properties.
# Variables marcadas con [aws-sdk] las lee directamente el AWS SDK cuando
#   inicializa el cliente S3.
# Variables sin marca son utilidad general.
#
# ⚠️  NUNCA commitear un .env real con secretos. Está en .gitignore.
# =============================================================================


# ─── Entorno general ──────────────────────────────────────────────────────
APP_ENV=dev                              # [compose] dev | staging | prod


# ─── Base de datos (Postgres) ─────────────────────────────────────────────
DB_HOST=localhost                        # [quarkus] en docker usar "postgres"
DB_PORT=5432                             # [compose][quarkus]
DB_NAME=electoral_db                     # [compose][quarkus]
DB_USER=electoral_user                   # [compose][quarkus]
DB_PASSWORD=                              # [compose][quarkus] REQUERIDO. Generar con `openssl rand -base64 24`.
POSTGRES_MEM_LIMIT=512M                  # [compose] límite RAM del contenedor


# ─── Storage S3 ───────────────────────────────────────────────────────────
# En PRODUCCIÓN: Supabase Storage (S3-compatible).
# En DEV: RustFS local (servicio S3 emulado) o minio.
#
# compose.yaml hace:
#   AWS_ACCESS_KEY_ID=${S3_ACCESS_KEY}
#   AWS_SECRET_ACCESS_KEY=${S3_SECRET_KEY}
#   AWS_S3_ENDPOINT=http://rustfs:${S3_PORT}
# Si corrés el backend nativo (mvn quarkus:dev) en host, las AWS_*
# son las que el AWS SDK lee directamente.
S3_ACCESS_KEY=                            # [compose] RustFS access key
S3_SECRET_KEY=                            # [compose] RustFS secret key
S3_PORT=9000                              # [compose] puerto S3
S3_CONSOLE_PORT=9001                      # [compose] puerto consola web (RustFS/MinIO)

AWS_ACCESS_KEY_ID=                        # [quarkus][aws-sdk]
AWS_SECRET_ACCESS_KEY=                    # [quarkus][aws-sdk]
AWS_S3_ENDPOINT=                          # [quarkus][aws-sdk] ej. http://localhost:9000 (dev) o https://xxx.supabase.co/storage/v1/s3 (prod)
AWS_S3_REGION=us-east-1                   # [quarkus][aws-sdk]
AWS_S3_BUCKET=electoral-evidences         # [quarkus][aws-sdk]
AWS_S3_PATH_STYLE=true                    # [quarkus][aws-sdk] true para RustFS/MinIO; false para AWS/Supabase real


# ─── Backend Quarkus ──────────────────────────────────────────────────
SERVER_PORT=8080                         # [compose][quarkus]
QUARKUS_LIQUIDASE_MIGRATE_AT_START=true   # [quarkus] aplicar migraciones al arrancar
QUARKUS_HIBERNATE_GENERATION=validate     # [quarkus] validate | none. Con `none` no exige que
                                          #   el schema exista: es lo que permite levantar una
                                          #   base VACIA, porque en Quarkus Hibernate valida
                                          #   antes de que Liquibase cree el schema.
QUARKUS_HIBERNATE_LOG_SQL=false           # [quarkus] true solo para debugging


# ─── JWT ──────────────────────────────────────────────────────────────────
# HS256 requiere secret >= 32 chars (256 bits). Generar con:
#   openssl rand -base64 48
APP_JWT_SECRET=                           # [quarkus] REQUERIDO. Mínimo 32 chars.
APP_JWT_REFRESH_PEPPER=                   # [quarkus] REQUERIDO. Usado para HMAC del hash de refresh tokens.
APP_JWT_ACCESS_TTL=15m                   # [quarkus] Duración del access token
APP_JWT_REFRESH_TTL=7d                   # [quarkus] Duración del refresh token
APP_JWT_ISSUER=control-elector           # [quarkus] Claim `iss` del JWT


# ─── Seed admin (DataSeeder crea este usuario en el primer arranque) ──────
APP_SEED_ADMIN_EMAIL=admin@control-elector.local   # [quarkus]
APP_SEED_ADMIN_PASSWORD=                            # [quarkus] CAMBIAR antes de cualquier deploy real.


# ─── Producción (Supabase + Railway) ──────────────────────────────────────
# Estas variables NO se usan en docker-compose. Las configura el proveedor
# (Railway env vars, Vercel env vars, Supabase dashboard) directamente.
DATABASE_URL=                             # [quarkus-prod] jdbc:postgresql://...supabase.co:5432/postgres
SUPABASE_URL=                             # [quarkus-prod] https://xxx.supabase.co
SUPABASE_SERVICE_KEY=                     # [quarkus-prod] service_role key de Supabase (server-side only)


# ─── Container restart policy ─────────────────────────────────────────────
# dev: 'no' — querés ver el error si algo crashea
# staging/prod: 'unless-stopped' o 'always'
RESTART_POLICY=no                         # [compose]


# ─── Logging (opcional) ──────────────────────────────────────────────────
QUARKUS_LOG_LEVEL=INFO                    # [quarkus] nivel global del framework
APP_LOG_LEVEL=DEBUG                       # [quarkus] nivel de ec.twintailcs.electoral.
                                          #   DEBUG en dev, INFO en prod


# =============================================================================
# Valores por defecto en código (si la variable no está en .env)
# =============================================================================
# backend/electoral-api-quarkus/src/main/resources/application.properties
# tiene defaults embebidos tipo ${VAR:default} para que el sistema arranque
# sin .env en dev con valores inseguros pero suficientes.
#
# ATENCIÓN en PRODUCCIÓN: el backend tiene un solo application.properties, sin
# perfil de prod, así que esos defaults siguen disponibles. Si DB_PASSWORD,
# APP_JWT_SECRET o APP_JWT_REFRESH_PEPPER no están seteadas, el backend arranca
# IGUAL con los valores de dev en vez de fallar. Verificar esas tres antes de
# cualquier deploy real.
# =============================================================================
