# =============================================================================
# .env.example — Plantilla canónica de variables de entorno
# =============================================================================
#
# Este archivo ES el template versionado. Está OK que se commitee.
#
# Para generar tu .env local:
#   cp .env.example .env
#   # editar valores (mínimamente: cambiar APP_JWT_SECRET y
#   # APP_JWT_REFRESH_PEPPER por secretos generados con
#   # `openssl rand -base64 48`)
#
# ─── Cómo se usan estas variables ──────────────────────────────────────────
# Variables marcadas con [compose] las consume docker-compose.
# Variables marcadas con [spring] las consume Spring Boot via @Value o
#   ${VAR} en application*.properties.
# Variables marcadas con [aws-sdk] las lee directamente el AWS SDK cuando
#   inicializa el cliente S3.
# Variables sin marca son utilidad general.
#
# ⚠️  NUNCA commitear un .env real con secretos. Está en .gitignore.
# =============================================================================


# ─── Entorno general ──────────────────────────────────────────────────────
APP_ENV=dev                              # [compose] dev | staging | prod


# ─── Base de datos (Postgres) ─────────────────────────────────────────────
DB_HOST=localhost                        # [spring] en docker usar "postgres"
DB_PORT=5432                             # [compose][spring]
DB_NAME=electoral_db                     # [compose][spring]
DB_USER=electoral_user                   # [compose][spring]
DB_PASSWORD=                              # [compose][spring] REQUERIDO. Generar con `openssl rand -base64 24`.
POSTGRES_MEM_LIMIT=512M                  # [compose] límite RAM del contenedor


# ─── Storage S3 ───────────────────────────────────────────────────────────
# En PRODUCCIÓN: Supabase Storage (S3-compatible).
# En DEV: RustFS local (servicio S3 emulado) o minio.
#
# compose.yaml hace:
#   AWS_ACCESS_KEY_ID=${S3_ACCESS_KEY}
#   AWS_SECRET_ACCESS_KEY=${S3_SECRET_KEY}
#   AWS_S3_ENDPOINT=http://rustfs:${S3_PORT}
# Si corrés el backend nativo (mvn spring-boot:run) en host, las AWS_*
# son las que el AWS SDK lee directamente.
S3_ACCESS_KEY=                            # [compose] RustFS access key
S3_SECRET_KEY=                            # [compose] RustFS secret key
S3_PORT=9000                              # [compose] puerto S3
S3_CONSOLE_PORT=9001                      # [compose] puerto consola web (RustFS/MinIO)

AWS_ACCESS_KEY_ID=                        # [spring][aws-sdk]
AWS_SECRET_ACCESS_KEY=                    # [spring][aws-sdk]
AWS_S3_ENDPOINT=                          # [spring][aws-sdk] ej. http://localhost:9000 (dev) o https://xxx.supabase.co/storage/v1/s3 (prod)
AWS_S3_REGION=us-east-1                   # [spring][aws-sdk]
AWS_S3_BUCKET=electoral-evidences         # [spring][aws-sdk]
AWS_S3_PATH_STYLE=true                    # [spring][aws-sdk] true para RustFS/MinIO; false para AWS/Supabase real


# ─── Backend Spring Boot ──────────────────────────────────────────────────
SERVER_PORT=8080                         # [compose][spring]
SPRING_PROFILES_ACTIVE=dev                # [spring] dev | prod
SPRING_APPLICATION_NAME=electoral-api     # [spring]
SPRING_JPA_HIBERNATE_DDL_AUTO=validate   # [spring] validate (prod) | update (dev) | none
SPRING_JPA_SHOW_SQL=false                # [spring] true solo para debugging


# ─── JWT ──────────────────────────────────────────────────────────────────
# HS256 requiere secret >= 32 chars (256 bits). Generar con:
#   openssl rand -base64 48
APP_JWT_SECRET=                           # [spring] REQUERIDO. Mínimo 32 chars.
APP_JWT_REFRESH_PEPPER=                   # [spring] REQUERIDO. Usado para HMAC del hash de refresh tokens.
APP_JWT_ACCESS_TTL=15m                   # [spring] Duración del access token
APP_JWT_REFRESH_TTL=7d                   # [spring] Duración del refresh token
APP_JWT_ISSUER=control-elector           # [spring] Claim `iss` del JWT


# ─── Seed admin (DataSeeder crea este usuario en el primer arranque) ──────
APP_SEED_ADMIN_EMAIL=admin@control-elector.local   # [spring]
APP_SEED_ADMIN_PASSWORD=                            # [spring] CAMBIAR antes de cualquier deploy real.


# ─── Producción (Supabase + Railway) ──────────────────────────────────────
# Estas variables NO se usan en docker-compose. Las configura el proveedor
# (Railway env vars, Vercel env vars, Supabase dashboard) directamente.
DATABASE_URL=                             # [spring-prod] jdbc:postgresql://...supabase.co:5432/postgres
SUPABASE_URL=                             # [spring-prod] https://xxx.supabase.co
SUPABASE_SERVICE_KEY=                     # [spring-prod] service_role key de Supabase (server-side only)


# ─── Container restart policy ─────────────────────────────────────────────
# dev: 'no' — querés ver el error si algo crashea
# staging/prod: 'unless-stopped' o 'always'
RESTART_POLICY=no                         # [compose]


# ─── Logging (opcional) ──────────────────────────────────────────────────
LOGGING_LEVEL_ROOT=INFO                   # [spring]
LOGGING_LEVEL_EC_TWINTAILCS=DEBUG         # [spring] DEBUG en dev, INFO en prod
LOGGING_LEVEL_HIBERNATE=WARN              # [spring]
LOGGING_LEVEL_SPRING_WEB=INFO             # [spring]


# =============================================================================
# Valores por defecto en código (si la variable no está en .env)
# =============================================================================
# application.properties / application-docker.properties / application-prod.properties
# tienen defaults embebidos tipo ${VAR:default} para que el sistema arranque
# sin .env en dev con valores inseguros pero suficientes. En PRODUCCIÓN
# las variables sensibles (DB_PASSWORD, APP_JWT_SECRET, AWS_SECRET_ACCESS_KEY)
# NO tienen default — fallan explícitamente si no están seteadas, lo cual
# es la postura correcta.
# =============================================================================
