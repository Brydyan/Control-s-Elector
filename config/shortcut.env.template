# Shortcut API Configuration
# Copy to .env and fill in your values

# API Token from Shortcut (https://app.shortcut.com/settings/account/api-tokens)
# Keep this PRIVATE — never commit to git
SHORTCUT_API_KEY=sct_rw_upse_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Default Epic ID (find in Shortcut URL: /epics/XXX)
# Can be overridden with --epic=ID in CLI
EPIC_ID=108

# Default Workflow State ID
# 500000006 = Backlog
# Can be overridden with --state=ID in CLI
WORKFLOW_STATE_ID=500000006
