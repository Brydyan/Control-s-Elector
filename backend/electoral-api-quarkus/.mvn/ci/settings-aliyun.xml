<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              http://maven.apache.org/xsd/settings-1.0.0.xsd">
  <!--
    Mirror alterno de Maven Central (Aliyun, CDN global).

    Entra en juego cuando el mirror de Google falla o se degrada: el Dockerfile
    rota entre los mirrors en cada reintento. Ver la nota sobre el primer mirror
    que coincide en settings-google.xml.
  -->
  <mirrors>
    <mirror>
      <id>central-aliyun</id>
      <mirrorOf>central</mirrorOf>
      <name>Maven Central (mirror Aliyun)</name>
      <url>https://maven.aliyun.com/repository/public</url>
      <blocked>false</blocked>
    </mirror>
  </mirrors>
</settings>
