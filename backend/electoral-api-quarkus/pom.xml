<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>ec.twintailcs</groupId>
	<artifactId>electoral-api-quarkus</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>electoral-api-quarkus</name>
	<description>
		Backend electoral sobre Quarkus — fase 1 de la issue #113 (migración desde Spring Boot).
		Es el backend destino del strangler: comparte schema (Liquibase), contratos HTTP
		(idénticos a los que fija la suite de regresión por contrato) y variables de entorno
		con el backend Spring.
	</description>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<maven.compiler.release>25</maven.compiler.release>

		<quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
		<quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
		<quarkus.platform.version>3.40.1</quarkus.platform.version>
		<quarkus-openpdf.version>3.3.3</quarkus-openpdf.version>

		<compiler-plugin.version>3.16.0</compiler-plugin.version>
		<surefire-plugin.version>3.5.6</surefire-plugin.version>
		<failsafe-plugin.version>3.5.6</failsafe-plugin.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>${quarkus.platform.group-id}</groupId>
				<artifactId>${quarkus.platform.artifact-id}</artifactId>
				<version>${quarkus.platform.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- REST -->
		<dependency>
			<groupId>io.quarkus</groupId>
			<artifactId>quarkus-rest</artifactId>
		</dependency>
		<dependency>
			<groupId>io.quarkus</groupId>
			<artifactId>quarkus-rest-jackson</artifactId>
		</dependency>

		<!-- Persistencia: el MISMO schema que el backend Spring (mismo changelog Liquibase). -->
		<dependency>
			<groupId>io.quarkus</groupId>
			<artifactId>quarkus-hibernate-orm-panache</artifactId>
		</dependency>
		<dependency>
			<groupId>io.quarkus</groupId>
			<artifactId>quarkus-jdbc-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>io.quarkus</groupId>
			<artifactId>quarkus-liquibase</artifactId>
		</dependency>

		<!-- Validación: mismo jakarta.validation que el backend Spring. -->
		<dependency>
			<groupId>io.quarkus</groupId>
			<artifactId>quarkus-hibernate-validator</artifactId>
		</dependency>

		<!-- JWT: se usa Nimbus JOSE igual que en Spring, para que los tokens sean
		     byte-compatibles entre las dos implementaciones durante el strangler. -->
		<dependency>
			<groupId>com.nimbusds</groupId>
			<artifactId>nimbus-jose-jwt</artifactId>
			<version>9.40</version>
		</dependency>

		<!-- AWS SDK v2: el mismo cliente que usa el backend Spring (RustFS en dev, Supabase S3
		     en prod). Se usa la libreria directo y no la extension quarkus-amazon-s3 para no
		     cambiar el modelo de configuracion: el backend Spring construye el S3Client a mano
		     y el contrato tiene que ser el mismo. -->
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>s3</artifactId>
			<version>2.30.0</version>
		</dependency>

		<!-- El cliente HTTP del AWS SDK se declara explicito en vez de dejarlo que lo
		     descubra por ServiceLoader. En imagen nativa GraalVM corre con
		     `-H:-UseServiceLoaderFeature` (default de Quarkus, no configurado aqui) y la
		     busqueda falla con `SdkClientException: Unable to load an HTTP
		     implementation from any provider in the chain`, que se traduce en un 500 en
		     toda operacion de evidencia. El artefacto ya venia transitivo en scope
		     runtime; se declara para poder referenciar ApacheHttpClient desde el codigo. -->
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>apache-client</artifactId>
			<version>2.30.0</version>
		</dependency>



		<!-- BCrypt: mismo algoritmo que usa el backend Spring. -->
		<dependency>
			<groupId>org.mindrot</groupId>
			<artifactId>jbcrypt</artifactId>
			<version>0.4</version>
		</dependency>

		<!-- OpenPDF: genera el PDF del expediente de impugnacion CNE (modulo de actas).
		     Misma libreria y misma version que usa el backend Spring, para que el documento
		     sea indistinguible entre las dos implementaciones. -->
		<!-- PDF del expediente de impugnacion. Entra por la extension de Quarkus y
		     no por el artifact suelto: la extension existe justamente para que
		     OpenPDF funcione en un ejecutable nativo, y su metadata de
		     reachability es lo que cierra el bloqueo de #114.
		     Issue #114. -->
		<dependency>
			<groupId>io.quarkiverse.openpdf</groupId>
			<artifactId>quarkus-openpdf</artifactId>
			<version>${quarkus-openpdf.version}</version>
		</dependency>

		<!-- Observabilidad: el health va en /actuator/health para no romper el contrato
		     con el backend Spring ni el job de CI. -->
		<dependency>
			<groupId>io.quarkus</groupId>
			<artifactId>quarkus-smallrye-health</artifactId>
		</dependency>
		<dependency>
			<groupId>io.quarkus</groupId>
			<artifactId>quarkus-smallrye-openapi</artifactId>
		</dependency>

		<!-- Test -->
		<dependency>
			<groupId>io.quarkus</groupId>
			<artifactId>quarkus-junit</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.rest-assured</groupId>
			<artifactId>rest-assured</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
			Testcontainers: Postgres real para el test de RLS. No se puede probar una politica de
			row-level security contra un mock ni contra H2: la politica vive en Postgres y el rol
			no-superuser (los superusers la saltean por atributo) es parte del escenario.

			Versiones fijadas a mano y no por el BOM de Quarkus para que coincidan con las que
			resuelve el backend Spring (backend/electoral-api/pom.xml): mismo testcontainers
			2.0.5 y mismo assertj 3.27.7 que los que trae el BOM de Spring Boot 4.1.0.
		-->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<version>2.0.5</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<version>2.0.5</version>
			<scope>test</scope>
		</dependency>

		<!-- AssertJ: misma version que el backend Spring y que la suite de contrato. -->
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<version>3.27.7</version>
			<scope>test</scope>
		</dependency>

		<!--
			El driver JDBC de Postgres NO se declara aca: quarkus-jdbc-postgresql ya lo trae en
			scope compile (org.postgresql:postgresql), asi que esta disponible en los tests.
		-->
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>io.quarkus</groupId>
				<artifactId>quarkus-maven-plugin</artifactId>
				<version>${quarkus.platform.version}</version>
				<extensions>true</extensions>
				<executions>
					<execution>
						<goals>
							<goal>build</goal>
							<goal>generate-code</goal>
							<goal>generate-code-tests</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>${compiler-plugin.version}</version>
			</plugin>

			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>2.44.5</version>
				<configuration>
					<ratchetFrom>origin/develop</ratchetFrom>
					<java>
						<googleJavaFormat>
							<version>1.27.0</version>
						</googleJavaFormat>
					</java>
				</configuration>
				<executions>
					<execution>
						<id>check-formatting</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			

			<!--
				Surefire corre tambien los *IT: los tests de RLS son de integracion (Testcontainers
				con Postgres real) y viven junto a los unitarios, igual que en el modulo Spring.
				Sin esto, `mvn test` no correria RlsIsolationIT y la cobertura de RLS seria
				decoracion.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>${surefire-plugin.version}</version>
				<configuration>
					<includes>
						<include>**/*Test.java</include>
						<include>**/*Tests.java</include>
						<include>**/*IT.java</include>
					</includes>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<version>${failsafe-plugin.version}</version>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<!--
				Build nativo. El AOT se compila dentro de un container porque el
				builder de Mandrel/GraalVM necesita mas memoria y toolchain de la
				que tiene un runner normal:

				  ./mvnw package -Dnative -Dquarkus.native.container-build=false

				Despues, el ejecutable nativo queda en target/*-runner.

				El `<activation>` por propiedad NO es opcional: sin el, Maven nunca
				activa este profile por su cuenta y `-Dnative` solo define una
				propiedad cualquiera, dejando `quarkus.native.enabled` en null. El
				build "pasaba" en verde haciendo un build JVM normal, sin pasar nunca
				por GraalVM, y `target/*-runner` no existia. Con el profile activar
				por `-Dnative`, tambien funciona la forma explicita `-Pnative`.
			-->
			<id>native</id>
			<activation>
				<property>
					<name>native</name>
				</property>
			</activation>
			<properties>
				<quarkus.native.enabled>true</quarkus.native.enabled>
				<quarkus.package.type>native</quarkus.package.type>
				<quarkus.native.container-build>true</quarkus.native.container-build>
			</properties>
		</profile>
	</profiles>

</project>
