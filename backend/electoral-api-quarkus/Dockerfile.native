# Contexto de build: el modulo `backend/electoral-api-quarkus/`.
#
#   docker build -f backend/electoral-api-quarkus/Dockerfile.native \
#     -t electoral-api backend/electoral-api-quarkus
#
# A diferencia de `Dockerfile`, este produce el EJECUTABLE NATIVO: la imagen de
# runtime no tiene JVM. Es el build que entrega el arranque en milisegundos, y el
# que exige 6-8 GB de RAM para `native-image` (por eso el job corre en CI, no en
# una maquina de desarrollo normal).
#
# El modulo entra a OpenPDF por la extension `quarkus-openpdf` (ver pom.xml): su
# `FopGlyphProcessorSubstitution` es lo que destraba el analisis de la imagen.
# Con el artifact suelto, `FopGlyphProcessor` referencia clases de `org.apache.fop`
# que no estan en el classpath y Graal aborta. Refs #114.

# ─── Build (Mandrel) ───────────────────────────────────────────────────────
FROM quay.io/quarkus/ubi-quarkus-mandrel-builder-image:jdk-21 AS build

WORKDIR /home/quarkus/proj

# `native-image-xmx` acota el heap del AOT. La guia de Quarkus reporta 6-8 GB de
# RSS para una app con Hibernate ORM; el runner estandar de GitHub tiene 16 GB y
# los 6-8 GB de RSS dejaban poco margen. Cuesta tiempo de build, que es el
# tradeoff que documenta la issue #114.
ARG MAVEN_OPTS="-Dquarkus.native.native-image-xmx=5g"
ENV MAVEN_OPTS=${MAVEN_OPTS}

# Primero el pom, para que la capa de dependencias se cachee sola.
COPY --chown=quarkus:quarkus pom.xml ./
RUN --mount=type=cache,target=/root/.m2,sharing=locked \
    mvn -B -ntp dependency:go-offline -DskipTests

COPY --chown=quarkus:quarkus src ./src

# `sources-only=false`: el builder por defecto mete los fuentes de las
# dependencias en la imagen, que no es lo que queremos.
RUN --mount=type=cache,target=/root/.m2,sharing=locked \
    mvn -B -ntp package -Dnative -DskipTests \
        -Dquarkus.native.sources-only=false \
        -Dquarkus.native.container-build=false

# ─── Runtime (sin JVM) ────────────────────────────────────────────────────
# UBI minimal y no la imagen distroless de Quarkus a proposito: distroless no
# trae shell ni curl, y sin shell no se puede expresar el HEALTHCHECK de
# Dockerfile ni inspeccionar el contenedor. UBI minimal mantiene ambas cosas y
# sigue sin JDK.
FROM quay.io/quarkus/ubi-quarkus-runtime-image:jdk-21

ENV LANGUAGE='en_US:en'

COPY --from=build --chown=185:0 /home/quarkus/proj/target/*-runner /deployments/
# Overrides de properties de la imagen, si el modulo los declara.
COPY --from=build --chown=185:0 /home/quarkus/proj/target/docker/ /deployments/

EXPOSE 8080
USER 185

ENV QUARKUS_HTTP_HOST=0.0.0.0

# El health del backend se sirve en /actuator/health del puerto principal
# (shared/web/HealthAliasResource), igual que en la imagen JVM: el contrato no
# cambia entre las dos imagenes.
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
  CMD curl -sf http://localhost:8080/actuator/health || exit 1

ENTRYPOINT [ "/deployments/quarkus-run" ]