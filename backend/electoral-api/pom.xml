<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/>
	</parent>

	<groupId>ec.twintailcs</groupId>
	<artifactId>electoral-api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>electoral-api</name>
	<description>API REST para Control Electoral — Elecciones Seccionales 2027-2031</description>

    <properties>
		<java.version>21</java.version>
	</properties>

	<dependencies>
		<!-- Web -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Security -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- JPA + PostgreSQL -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Liquibase — versionamiento de schema (reemplaza ddl-auto).
    	     Spring Boot 4.x requiere el starter explicito; liquibase-core
    	     solo no se autoconfigura (cambio vs Spring Boot 3.x). -->
    	<dependency>
    		<groupId>org.springframework.boot</groupId>
    		<artifactId>spring-boot-starter-liquibase</artifactId>
    	</dependency>

		<!-- MapStruct — mapeo DTO ↔ Entidad con resolución automática de UUIDs -->
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct</artifactId>
			<version>1.6.3</version>
		</dependency>

		<!-- Validación -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Lombok -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- AWS SDK v2 — S3 client (singleton). RustFS local / Supabase S3 en prod. -->
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>s3</artifactId>
		 <version>2.30.0</version>
		</dependency>

		<!-- Nimbus JOSE+JWT: para emitir y validar JWTs (login/refresh). -->
		<dependency>
			<groupId>com.nimbusds</groupId>
			<artifactId>nimbus-jose-jwt</artifactId>
		 <version>9.40</version>
		</dependency>

		<!-- Actuator (endpoints /actuator/health, /info, /metrics + HealthIndicators). -->
    	<dependency>
    		<groupId>org.springframework.boot</groupId>
    		<artifactId>spring-boot-starter-actuator</artifactId>
    	</dependency>

		<!-- UUIDv7 generator (RFC 9562). Isolado detras de UuidV7Generator para
		     poder eliminarlo cuando Hibernate >=7.2 traiga UuidVersion7Strategy
		     nativo (ver ADR 0001). Pin explicito: no hay BOM que lo maneje. -->
		<dependency>
			<groupId>com.github.f4b6a3</groupId>
			<artifactId>uuid-creator</artifactId>
			<version>6.1.1</version>
		</dependency>

    	<!-- OpenAPI 3 / Swagger UI (springdoc 3.x — compatible con Spring Boot 4.x).
    	     Genera /v3/api-docs (JSON+YAML) y /swagger-ui.html a partir de los controllers.
    	     El esquema JWT bearer y la metadata se definen en OpenApiConfig. -->
    	<dependency>
    		<groupId>org.springdoc</groupId>
    		<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    		<version>3.0.3</version>
    	</dependency>

		<!-- @PreAuthorize(@authz.has(...)) se apoya en el AOP que
		     spring-security ya trae; no requiere dependencia extra. -->

		<!-- AOT / GraalVM Native Image: el processing se hace vía el plugin
		     (native-maven-plugin) y el profile `native` de spring-boot-maven-plugin.
		     No requiere una dependencia starter explícita. -->

		<!-- Test -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Spring Boot 4.x modularizo los test slices fuera de
		     spring-boot-test-autoconfigure: @DataJpaTest y @WebMvcTest ahora
		     viven en modulos dedicados (no en spring-boot-starter-test). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Testcontainers: Postgres real para @DataJpaTest (uuid nativo /
		     gen_random_uuid() no existen en H2). Versiones gestionadas por el
		     BOM de spring-boot-starter-parent 4.1. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- T-BE-20: generación de PDF de expediente de impugnación.
		     LGPL/MPL, sin coste de licencia (alternativa iText 7/8 es privativa). -->
		<dependency>
			<groupId>com.github.librepdf</groupId>
			<artifactId>openpdf</artifactId>
			<version>2.0.3</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
						<path>
							<groupId>org.mapstruct</groupId>
							<artifactId>mapstruct-processor</artifactId>
							<version>1.6.3</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<!-- Liquibase Maven Plugin
			     Permite correr goals CLI de Liquibase (update / changelog-sync /
			     rollback / etc) desde Maven. spring-boot-starter-liquibase solo
			     aporta el autoconfig de runtime; el plugin CLI es separado.
			     Alineado a la misma version que liquibase-core (5.0.3) para
			     evitar conflictos. -->
			<plugin>
				<groupId>org.liquibase</groupId>
				<artifactId>liquibase-maven-plugin</artifactId>
				<version>5.0.3</version>
			</plugin>

			<!-- Surefire: incluir *IT.java además de *Test.java por convención del proyecto.
			     Los ITs de storage (StorageCompensationIT, DeleteS3FailureIT, AuditLogBaselineIT)
			     son integration tests con Testcontainers que viven junto a unit tests para
			     simplificar el run. Si se prefiere separar, mover a failsafe y renombrar. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<includes>
						<include>**/*Test.java</include>
						<include>**/*Tests.java</include>
						<include>**/*IT.java</include>
					</includes>
					<!--
						La suite corre contra una base con SOLO el esquema, sin el seed de
						datos de referencia (contexto Liquibase "seed"). Los fixtures de los
						tests construyen su propia geografía con códigos fijos (provincia
						'24', cantón '2401'), afirman una base vacía y esperan que el
						primer partido sea el que crean: con el seed aplicado, el setup
						revienta por colisión de índices únicos.

						Una system property tiene más precedencia que application.properties,
						así que esto pisa el `spring.liquibase.contexts=seed` de la app sin
						tocar ningún archivo de properties de test.
					-->
					<systemPropertyVariables>
						<spring.liquibase.contexts>schema-only</spring.liquibase.contexts>
					</systemPropertyVariables>
				</configuration>
			</plugin>

			<!-- GraalVM Native Image Plugin
			     Spring Boot parent POM ya maneja la versión y config vía
			     el profile `-Pnative`. Solo declaramos el plugin aquí.
			     El build se hace desde Docker con:
			       ./mvnw -Pnative package -DskipTests -B
			     Eso corre: compile -> process-aot (AOT) -> package -> compile-no-fork (native-image).
			-->
			<plugin>
				<groupId>org.graalvm.buildtools</groupId>
				<artifactId>native-maven-plugin</artifactId>
			</plugin>

			<!-- Incremental Java formatting gate. ratchetFrom keeps the historical
			     baseline untouched while checking Java changed from develop. -->
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>2.43.0</version>
				<configuration>
					<ratchetFrom>origin/develop</ratchetFrom>
					<java>
						<googleJavaFormat>
							<version>1.25.2</version>
						</googleJavaFormat>
					</java>
				</configuration>
				<executions>
					<execution>
						<id>check-formatting</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Generate coverage reports without imposing a historical threshold. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.13</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>native</id>
			<build>
				<plugins>
					<!-- Spring Boot AOT processing: genera hint files para native-image -->
					<plugin>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>process-aot</id>
								<goals>
									<goal>process-aot</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<!-- Compilar native-image durante `mvn package` -->
					<plugin>
						<groupId>org.graalvm.buildtools</groupId>
						<artifactId>native-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>build-native</id>
								<goals>
									<goal>compile-no-fork</goal>
								</goals>
								<phase>package</phase>
							</execution>
						</executions>
						<configuration>
							<!--
							  Configuracion del native-image builder.
							  no-fallback: si falla la compilacion AOT, falla el build
							              en lugar de caer a JVM mode.
							  Sin J-Xmx fijo: el builder usa 80% del heap disponible.
							  GC: GraalVM 25 usa epsilon o serial por defecto. serial
							      es seguro y suficiente para la mayoria de los builds.
							  Requiere Docker Desktop con 6GB+ de memoria asignada.
							-->
							<buildArgs>
								<buildArg>--no-fallback</buildArg>
								<buildArg>--gc=serial</buildArg>
								<buildArg>--parallelism=1</buildArg>
							</buildArgs>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
