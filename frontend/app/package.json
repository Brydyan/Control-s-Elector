{
  "name": "app",
  "version": "0.0.1",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "npm run licenses:build && ng serve",
    "build": "npm run licenses:build && ng build",
    "watch": "npm run licenses:build && ng build --watch --configuration development",
    "licenses:build": "node scripts/generate-licenses.js",
    "test": "vitest",
    "test:ci": "vitest run",
    "check:tokens": "node scripts/check-tokens.mjs",
    "lint": "ng lint",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "dependencies": {
    "@angular/animations": "21.2.25",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/platform-browser-dynamic": "21.2.25",
    "@angular/router": "21.2.25",
    "@angular/service-worker": "21.2.25",
    "@capacitor/android": "8.4.1",
    "@capacitor/core": "8.4.1",
    "@primeuix/themes": "2.0.3",
    "idb": "^8.0.3",
    "primeicons": "7.0.0",
    "primeng": "21.1.10",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "3.0.0-alpha.90",
    "@angular-devkit/build-angular": "21.2.27",
    "@angular-eslint/builder": "21.4.0",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/schematics": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@angular/cdk": "21.2.14",
    "@angular/cli": "21.2.27",
    "@angular/compiler-cli": "21.2.25",
    "@angular/language-service": "21.2.25",
    "@capacitor/cli": "8.4.1",
    "@ionic/angular-toolkit": "^12.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.1.11",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.16.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.2.1",
    "eslint-plugin-prefer-arrow": "1.2.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "4.1.11",
    "tailwindcss-primeui": "0.6.1",
    "typescript": "~5.9.3",
    "vite": "^8.1.3",
    "vitest": "^5.0.2"
  },
  "description": "An Ionic project"
}
